  <!-- GAZEBO CAMERA SENSOR 1 -->
  <gazebo reference="camera">
    <sensor name="camera_sensor_1" type="camera">
      <pose>0 0 0 0 1.5707963 0</pose>
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>true</visualize>
      <topic>camera_1/image</topic>
      <camera>
        <horizontal_fov>1.5707963</horizontal_fov>
        <image>
          <width>1920</width>
          <height>1080</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>100</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

